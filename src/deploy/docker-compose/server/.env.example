# Copy to .env and fill in deployment-specific values. Never commit .env.
# Keep this stable: changing it selects different named volumes.
COMPOSE_PROJECT_NAME=moj-server
GHCR_OWNER=julianrr-123
# Use the same full sha-<commit> tag for both successfully published images.
MOJ_IMAGE_TAG=

# Reserved for the URL configuration and realm rendering in tasks 12–13.
# These values do not change the copied local login configuration yet.
PUBLIC_IP=
MOJ_BASE_URL=
AUTH_BASE_URL=

POSTGRES_PASSWORD=
IAM_DB_PASSWORD=
MOJ_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
