# Copy to .env and fill in deployment-specific values. Never commit .env.
# Keep this stable: changing it selects different named volumes.
COMPOSE_PROJECT_NAME=moj-server
GHCR_OWNER=julianrr-123
# Use the same full sha-<commit> tag for both successfully published images.
MOJ_IMAGE_TAG=

# Run python3 prepare-urls.py after setting these literal values.
# Restricted test: blank base URLs derive http://PUBLIC_IP:8080 and :8888.
# Public deployment: set both base URLs explicitly to HTTPS origins and use --mode public.
# No trailing path, query, credentials, or environment-variable interpolation.
# Load generated/urls.env after .env with Compose's second --env-file option.
PUBLIC_IP=
MOJ_BASE_URL=https://moj.avaj.com
AUTH_BASE_URL=https://auth.avaj.com

POSTGRES_PASSWORD=
IAM_DB_PASSWORD=
MOJ_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
ARTEMIS_USER=
ARTEMIS_PASSWORD=
